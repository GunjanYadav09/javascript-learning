// # arrow function (=>) with addEventListener().

// Example: Change paragraph text on button click

// <p id="message">Hello!</p>
// <button id="btn">Click Me</button>

let paragraph1 = document.querySelector("#message");
let button1 = document.querySelector("#btn");

button1.addEventListener("click", () => {
    paragraph.textContent = "Welcome!";
});

// () => {} is the arrow function, which acts as the event handler.
// "click" specifies the event to listen for.
// When the button is clicked, the arrow function executes.
// textContent changes the paragraph's text.


// Another example: Arrow function with the event object

button1.addEventListener("click", (event) => (
    console.log(event.target);
    console.log(event.target);
));

// Here, event receives the event object, just as it does in a regular function.

// => Remember both syntaxes:

// Regular function:
button.addEventListener("click", function(event) {
    console.log(event.type);
});

// Arrow function:
button.addEventListener("click", (event) => {
    console.log(event.type);
});
// Arrow functions provide a shorter syntax.


// # Keyboard Events in JavaScript :

// -> Keyboard events allow JavaScript to respond when a user presses or releases a key.
// ex:
// Press Enter to submit a form.
// Press Escape to close a menu.
// Press a key in a text box to detect what the user typed.
// Use arrow keys to control a game.

// => Three important keyboard events:

// keydown = Fires when a key is pressed down
// keyup = Fires when a key is released
// keypress = Legacy event; avoid using it in new code

// 1. keydown event
// -> keydown occurs when the user presses a key.

// <input id="username" placeholder="Type something">

let input = document.querySelector("#username");

input.addEventListener("keydown", function(event) {
    console.log("key pressed!");
});

// -> When you press a key while the input is focused, the message appears in the console.


// 2. event.key
// -> The event.key property tells us which key was pressed.

input.addEventListener("keydown", function(event) {
    console.log(event.key);
});

// ex:
//  USER PRESSES               event.key
//      A                   "a" or "A" depending on Shift
//  Enter                   "Enter"
//  Space                    " "
//  Escape                   "Escape"
//  Arrow Up                 "ArrowUp"
//  Backspace                "Backspace"

// -> For letter keys, the value reflects the character produced, including Shift or keyboard layout.


// 3. Detecting a specific key :

// -> let's detect when the user presses Enter.

let input = document.querySelector("#username");

input.addEventListener("keydown", function(event) {
    if(event.key === "Enter") {
        console.log("Enter key is pressed!")
    }
});

// How it works:
// The user presses a key inside the input.
// The keydown event fires.
// event.key identifies the key.
// The if condition checks whether it is "Enter".
// If true, the message is printed.


// 4. keyup event :

// -> keyup fires when the user releases a key.

input.addEventListener("keyup", function(event) {
    console.log("Released:", event.key);
});

// For example, if you press and release A:
// keydown → "a"
// keyup   → "a"

// => The keydown event occurs on pressing; keyup occurs on releasing.


// 5. A practical example: Detect Escape :

document.addEventListener("keydown", function(event) {
    if(event.key === "Escape") {
        console.log("Escape pressed!");
    }
});

// -> Here, the listener is "attached to document",
// so it can detect Escape presses "across the page", provided the page has keyboard focus.


// # 🧠 Key concepts

// keydown → key pressed
// keyup → key released
// event.key → identifies the key
// event.key === "Enter" → checks for Enter
// document.addEventListener(...) → listens at the document level


// # 🧪 Your turn :

// <input id="name" placeholder="Enter your name">

// Write JavaScript to:
// Select the input using querySelector().
// Attach a keydown event listener.
// Check whether the pressed key is "Enter".
// If Enter is pressed, print "Form submitted!" in the console.
// Bonus: Add an else condition that prints the key the user pressed.

let input = document.querySelector("#name");
input.addEventListener("keydown", function(event) {
    if(event.key === "Enter") {
        console.log("Form submitted!");
    }
    else {
        console.log(event.key);
    }
});

// NOTE : 
// Your code prints "Form submitted!" when Enter is pressed,
// but it doesn't actually submit a form.
// To submit a real form, you would use a form's submit event or call its submission method after appropriate validation.


